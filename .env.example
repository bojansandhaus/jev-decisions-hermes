# Copy to .env locally if desired. Never commit a real value.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
TYPESAFE_API_KEY=YOUR_TYPESAFE_API_KEY
# openrouter, typesafe, typesafe_then_openrouter, openrouter_then_typesafe,
# clef, or a local first chain: laya_then_typesafe, laya_then_openrouter,
# laya_then_typesafe_openrouter, laya_then_openrouter_typesafe.
# The DOGA selector names laya_local, laya_with_jev_fallback and clef_api are also
# accepted: laya_local is laya, laya_with_jev_fallback is
# laya_then_openrouter_typesafe, which tries laya, then openrouter, then
# typesafe, and clef_api is clef on its own with no fallback.
# The hosted modes run Jev over a hosted key, or run Clef at Cloudflare Workers
# AI. `laya` runs Laya locally with no key and no hosted hop. A `laya_then_*`
# mode answers locally first and falls through to the hosted provider(s) it
# names, so a failed local attempt sends the case state to that hosted API; the
# key for every named provider is required, and a missing one stops the mode at
# selection. After three consecutive local failures in one process the fallback
# stops and the local error is raised instead, until a local answer succeeds
# again.
JEV_PROVIDER_MODE=openrouter
# The hosted Clef route. The account id is configuration, not a secret, but it
# appears in the request URL, so keep it in the environment of the process that
# runs your sessions. The token is a credential: hold it in the Hermes secret
# scope, and give it Account > Workers AI > Read. Both are checked before any
# request, and a missing one fails naming the variable. The route has no
# fallback, so a Clef failure is an unavailable review rather than a reason to
# call another classifier.
# CLOUDFLARE_ACCOUNT_ID=YOUR_32_CHARACTER_CLOUDFLARE_ACCOUNT_ID
# CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
# Clef's checkpoint. clef is the base model; clef-flash is the smaller one.
# A checkpoint of the one provider, not a second provider.
JEV_CLEF_MODEL=clef
# The local hop. Read by `laya` and by every `laya_then_*` mode.
JEV_LAYA_BASE_URL=http://127.0.0.1:8123
JEV_LAYA_ENDPOINT_PATH=/v1/systemone
JEV_LAYA_MODEL=english
# Only for a laya-serve started with its own bearer check. Leave unset otherwise.
# LAYA_API_KEY=YOUR_LAYA_SERVER_TOKEN
JEV_HOME=$HOME/.jev
